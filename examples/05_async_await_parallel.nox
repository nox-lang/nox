package main

import(
    "io",
    "time"
)

async func fetchData(n) {
    time::Sleep(0.05)
    return n * 2
}

async func slowGreeting() {
    time::Sleep(0.02)
    return "hello async"
}

func Main() {
    let task = fetchData(21)
    let result = await task
    io::Println(result.toString())

    let g = await slowGreeting()
    io::Println(g)

    let results = await parallel {
        fetchData(1)
        fetchData(2)
        fetchData(3)
    }
    results.each((x) {
        io::Print(x.toString())
        io::Print(" ")
