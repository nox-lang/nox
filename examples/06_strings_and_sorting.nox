package main

import(
    "io"
)

include(
    "stdio.h"
)

class Counter {
    let count

    func init() {
        this.count = 0
    }

    func Increment() {
        this.count = this.count + 1
    }

    func Value() {
        return this.count
    }
}

func Main() {
    let text = "Hello, Nox World"
    io::Println(text.contains("Nox").toString())
    io::Println(text.startsWith("Hello").toString())
    io::Println(text.endsWith("World").toString())
    io::Println(text.substring(7, 10))
    io::Println(text.empty().toString())

    let multiline = "line1\nline2\nline3"
    multiline.eachLine((line) {
        io::Println(line)
    })

    let numbers = [5, 3, 1, 4, 2]
    numbers.sort()
    numbers.each((x) { io::Print(x.toString())
        io::Print(" ") })
    io::Println("")

    let words = ["banana", "apple", "cherry"]
    words.sort((a, b) {
        return a < b
    })
    words.each((x) { io::Print(x)
        io::Print(" ") })
    io::Println("")

    let matrix = [
        [1, 2],
        [3, 4]
    ]
    io::Println(matrix[1][0].toString())

    let c = Counter.new()
    c.Increment()
    c.Increment()
    c.Increment()
    io::Println(c.Value().toString())

    stdio::printf("raw C printf: %d\n", 123)

    let found = numbers.find((x) { yield x > 3 })
    io::Println(found.toString())
}
