package main

import(
    "io"
)

class Dog {
    let name
    let Age

    func init(name, age) {
        this.name = name
        this.Age = age
    }

    func Bark() {
        io::Print(this.name)
        io::Println(" says Woof!")
    }

    func Birthday() {
        this.Age = this.Age + 1
    }
}

func Main() {
    let dog = Dog.new("Pochi", 3)
    dog.Bark()
    io::Println(dog.Age.toString())
    dog.Birthday()
    io::Println(dog.Age.toString())

    switch (dog.Age) {
        case 4 {
            io::Println("four")
        }
        case 5, 6 {
            io::Println("five or six")
        }
        default {
            io::Println("other")
        }
    }

    let label = switch (dog.Age) {
        case 4 {
            break "young"
        }
        default {
            break "old"
        }
    }
    io::Println(label)

    let found = for (x in [1, 2, 30, 4]) {
        if (x > 10) {
            break x
        }
    }
    io::Println(found.toString())

    let collected = for (x in [1, 2, 3, 4, 5]) {
        if (x > 2) {
            next x * 10
        }
