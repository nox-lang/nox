package main

import(
    "io"
)

class Dog {
    let name
    let Age

    func init(name, age) {
        this.name = name
        this.Age = age
    }

    func Bark() {
        io::Print(this.name)
        io::Println(" says Woof!")
    }

    func Birthday() {
        this.Age = this.Age + 1
    }
}
