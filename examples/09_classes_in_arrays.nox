package main

import(
    "io"
)

class Item {
    let Label
    func init(label) {
        this.Label = label
    }
}

func Main() {
    let items = [Item.new("x"), Item.new("y"), Item.new("z")]
    io::Println(items.length.toString())
    io::Println(items[0].Label)
    io::Println(items[2].Label)

    let notFound = items.find((i) { yield i.Label == "zzz" })
    io::Println((notFound == null).toString())

    items.each((i) {
        io::Println(i.Label)
    })
}
