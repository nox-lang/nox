package main

import(
    "io"
)

func add(a, b) {
    return a + b
}

func Main() {
    let x = 10
    let y = 20
    let z = add(x, y)
    io::Println(z.toString())

    let f = add(1.5, 2.5)
    io::Println(f.toString())

    let name = "World"
    let msg = "Hello, " + name + "!"
    io::Println(msg)

    if (z > 25) {
        io::Println("big")
    } else {
        io::Println("small")
    }

    let numbers = [1, 2, 3, 4, 5]
    io::Println(numbers.length.toString())

    for (n in numbers) {
        io::Print(n.toString())
        io::Print(" ")
    }
    io::Println("")

    for (i, n in numbers) {
        io::Printfn("{}: {}", i, n)
    }

    let doubled = numbers.map((x) {
        yield x * 2
    })
    doubled.each((x) {
        io::Print(x.toString())
        io::Print(" ")
    })
    io::Println("")
