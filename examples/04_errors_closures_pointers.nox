package main

import(
    "io"
)

func load(path) {
    let text = fs::Read(path)?
    return text
}

func Main() {
    fs::Write("/tmp/noxtest_file.txt", "hello from nox")?

    try {
        let text = load("/tmp/noxtest_file.txt")
        io::Println(text)
    } catch (error) {
        io::Println("unexpected error:")
        io::Println(error)
    }

    try {
        let text = load("/tmp/does_not_exist_nox.txt")
        io::Println(text)
    } catch (error) {
        io::Println("caught error:")
        io::Println(error)
    }

    // closures
    let double = (x: int) {
        return x * 2
    }
    io::Println(double(21).toString())

    let n = 100
    let addN = (x: int) {
        return x + n
    }
    io::Println(addN(5).toString())

    // pointers
    let value = 42
    let p: pointer<int> = &value
    let deref = *p
    io::Println(deref.toString())

    // default args + variadic
    let g = greet()
    io::Println(g)
    let g2 = greet("Nox")
    io::Println(g2)

    let s = sum(1, 2, 3, 4)
    io::Println(s.toString())
}

func greet(name = "World") {
    return "Hello, " + name
}

func sum(values...) {
    let total = 0
    for (v in values) {
        total += v
