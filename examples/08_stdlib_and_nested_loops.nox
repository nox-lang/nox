package main

import(
    "io",
    "random",
    "path",
    "time",
    "math"
)

class Box {
    let value
    func init(value) {
        this.value = value
    }
    func Get() {
        return this.value
    }
}

func Main() {
    let boxInt = Box.new(42)
    let boxStr = Box.new("hello")
    io::Println(boxInt.Get().toString())
    io::Println(boxStr.Get())

    let s1 = "abc"
    let s2 = "abc"
    let s3 = "abd"
    io::Println((s1 == s2).toString())
    io::Println((s1 == s3).toString())
    io::Println((s1 < s3).toString())

