package main

import(
    "io",
    "random",
    "path",
    "time",
    "math"
)

class Box {
    let value
    func init(value) {
        this.value = value
    }
    func Get() {
        return this.value
    }
}

func Main() {
    let boxInt = Box.new(42)
    let boxStr = Box.new("hello")
    io::Println(boxInt.Get().toString())
    io::Println(boxStr.Get())

